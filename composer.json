{
    "name": "offbeatwp/images",
    "description": "Responsive images with focalpoints generate on demand",
    "type": "offbeatwp-service",
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "autoload": {
        "psr-4": {
            "OffbeatWP\\Images\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Chris Schrijver",
            "email": "chris@opvollegrond.nl"
        }
    ],
    "require": {
        "php": ">=8.3",
        "offbeatwp/framework": "dev-epic/offbeat-4"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.11",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "roave/security-advisories": "dev-latest"
    }
}
